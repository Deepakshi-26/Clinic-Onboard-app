generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  HR
  EMPLOYEE
}

enum JobTitle {
  PHYSIOTHERAPIST
  OCCUPATIONAL_THERAPIST
  PHYSIO_ASSISTANT
  OT_ASSISTANT
  PHYSIO_TECHNOLOGIST
  DOCTOR
  REHAB_ADMIN
  MEDICAL_ADMIN
  CNESST_ADMIN
  SAAQ_ADMIN
  BC_ADMIN
  HR
  MANAGER
}

enum Location {
  PARC_EXTENSION
  MONTREAL_NORD
  COTE_VERTU
  LACHINE
}

enum EmployeeStatus {
  INVITED
  ACTIVE
  COMPLETED
  INACTIVE
}

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
}

enum EmailKind {
  INVITE
  REMINDER
}

enum MessageChannel {
  HR_EMPLOYEE
  PEER
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Set once the user actually completes /accept-invite. Null means the
  // account was created (by an invite) but still has the unusable
  // placeholder password — distinguishes "Resend Invite" (first-time setup)
  // from "Send Password Reset" (they're already active) in the UI.
  passwordSetAt DateTime?

  employee     Employee?
  accounts     Account[]
  sessions     Session[]
  chatMessages ChatMessage[]
}

// Standard Auth.js Prisma-adapter shape. Not exercised by the Credentials+JWT
// flow today; present so adding an OAuth provider later is config-only.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Employee {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // fullName is derived from first/middle/last and kept in sync on every
  // create/update — kept as its own column since it's what almost every
  // display, search, and sort in the app reads.
  fullName               String
  firstName              String         @default("")
  middleName             String?
  lastName               String         @default("")
  title                  JobTitle
  location               Location
  startDate              DateTime
  onboardingDurationDays Int            @default(30)
  status                 EmployeeStatus @default(INVITED)

  // Free text for milestone 1 — the Invite form's "Assigned Trainer" dropdown is
  // a hardcoded list, not a Staff/Trainer directory model.
  trainerName    String?
  welcomeMessage String?

  // Personal info — the HR "Documents" checklist is computed from these being
  // non-null, not from a separate documents table.
  dateOfBirth        DateTime?
  phone              String?
  personalEmail      String
  residentialAddress String?
  workEmail          String? // set later via a deferred Access & Passwords screen

  // Encrypted at rest — see src/lib/encryption.ts. Ciphertext only, never plaintext.
  sinNumberEnc        String?
  healthCardNumberEnc String?
  permitNumberEnc     String?
  voidChequeUploaded  Boolean @default(false)

  hrNotes String?

  // Stored percentage for milestone 1; swap for a computed value once a real
  // training-materials/completion model exists.
  trainingProgressPct Int       @default(0)
  completedAt         DateTime?
  // Set when HR marks the employee inactive instead of deleting them — the
  // record and all related data (goals, documents, messages, schedule) are
  // kept for history; only portal login access is revoked (see src/auth.ts).
  inactiveAt          DateTime?

  goals             Goal[]
  emailLogs         EmailLog[]
  assignedDocuments TrainingDocument[]
  accessCredentials AccessCredential[]
  personalDocuments PersonalDocument[]
  messages          Message[]          @relation("MessageEmployee")
  peerMessages      Message[]          @relation("MessagePeerEmployee")
  sentMessages      Message[]          @relation("MessageSender")
  scheduleItems     ScheduleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type         GoalType
  title        String
  description  String?
  periodNumber Int // day # for DAILY, week # for WEEKLY, day # (e.g. 30) for MONTHLY
  order        Int       @default(0)
  done         Boolean   @default(false)
  doneAt       DateTime?

  createdAt DateTime @default(now())
}

// A document is visible to an employee if either: their title is in `roles`,
// OR they're individually listed in `assignedEmployees`. The two are additive
// (a doc can target a whole role AND a few extra specific people at once),
// not mutually exclusive.
model TrainingDocument {
  id       String @id @default(cuid())
  name     String
  docType  String
  fileUrl  String
  fileName String
  fileSize Int

  roles             JobTitle[]
  assignedEmployees Employee[]

  uploadedAt DateTime @default(now())
}

// One row per employee per location. Passcodes/passwords are encrypted at
// rest (see src/lib/encryption.ts), same as Employee's sensitive fields.
model AccessCredential {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location   Location

  workEmail String?

  doorPasscodeEnc     String?
  buildingPasscodeEnc String?
  wifiPasswordEnc     String?
  medexaUsername      String?
  medexaPasswordEnc   String?
  medexaLink          String?
  myleUsername        String?
  mylePasswordEnc     String?
  myleLink            String?

  equipmentBoxLocation  String?
  equipmentRequestEmail String?
  trainerName           String?

  parkingEnabled Boolean @default(false)
  parkingNote    String?

  updatedAt DateTime @updatedAt

  @@unique([employeeId, location])
}

// Files an employee uploads about themselves (void cheque photo, permit
// photo, etc.) — the reverse direction of TrainingDocument, where HR uploads
// materials for employees. Freeform `label` rather than a fixed enum since
// HR may ask for different proof documents per role/situation.
model PersonalDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  label    String
  fileUrl  String
  fileName String
  fileSize Int

  uploadedAt DateTime @default(now())
}

// Two thread shapes share this table:
// - HR_EMPLOYEE: employeeId is the employee HR is talking to; peerEmployeeId
//   is null. HR is a single shared inbox (no per-HR-user threads).
// - PEER: a thread between two employees onboarding at the same time.
//   employeeId/peerEmployeeId are normalized (employeeId < peerEmployeeId by
//   id) so both participants resolve to the same thread regardless of who
//   started it.
model Message {
  id             String         @id @default(cuid())
  channel        MessageChannel
  employeeId     String
  employee       Employee       @relation("MessageEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  peerEmployeeId String?
  peerEmployee   Employee?      @relation("MessagePeerEmployee", fields: [peerEmployeeId], references: [id], onDelete: Cascade)

  senderRole       UserRole
  // Which employee actually wrote this message — required to tell the two
  // participants apart on a PEER thread, where both have senderRole EMPLOYEE.
  // Null when senderRole is HR (HR is a shared inbox, not tied to one employee).
  senderEmployeeId String?
  senderEmployee   Employee? @relation("MessageSender", fields: [senderEmployeeId], references: [id], onDelete: SetNull)

  body String

  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?

  createdAt DateTime  @default(now())
  // Set when the recipient(s) have viewed the thread this message belongs
  // to — null means sent/delivered but not yet read.
  readAt    DateTime?

  @@index([channel, employeeId])
  @@index([channel, peerEmployeeId])
}

// A single dated item on an employee's onboarding itinerary (e.g. "Mon Nov 10
// — Orientation with HR"). Separate from Goal: goals are a checklist tied to
// abstract day/week numbers, this is a real calendar itinerary HR builds out
// for a specific employee and the employee views read-only.
model ScheduleItem {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date  DateTime
  time  String? // freeform, e.g. "10:00 AM" — no timezone/duration modeling needed yet
  title String
  notes String?

  createdAt DateTime @default(now())

  @@index([employeeId, date])
}

// Reused for both the Invite "Send Invitation Email" stub and the Dashboard
// "Send Reminder" stub — gives HR a real audit trail without a real email
// provider. Never stores secrets (e.g. temp passwords).
model EmailLog {
  id         String    @id @default(cuid())
  kind       EmailKind
  toEmail    String
  subject    String
  body       String
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

// Each user (HR or employee) has their own AI chatbot conversation —
// not shared like the HR/employee Message inbox.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
